<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Two sources and nothing else. Clearing inherited sources keeps a machine-level feed out of
       the graph and settles NU1507, which central package management raises whenever more than one
       source can answer for a package. The source mapping below is what makes the two safe
       together: every ZeroZero.* name is answered by the family feed alone, and everything else by
       nuget.org alone, so neither feed can be substituted for the other.

       GitHub Packages authenticates every read, including of a public package, so a restore needs a
       token carrying read:packages — on a developer's machine and on a CI runner alike. The
       credential is never written here. NuGet takes it from the environment variable
       NuGetPackageSourceCredentials_zerozero, whose value is Username=<account>;Password=<token>,
       and the MSBuild SDK resolver that fetches the build kit reads the same variable. Measured
       with no user-level NuGet configuration in reach and an empty package cache: the variable
       alone resolves the kit and restores the packages, and without it the restore stops at
       NU1301 with a 401. -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="zerozero" value="https://nuget.pkg.github.com/0z00z0/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="zerozero">
      <package pattern="ZeroZero.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
